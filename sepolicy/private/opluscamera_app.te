# OplusCamera is a preinstalled platform app (system_ext). Treble labeling
# requires all platform apps to be labeled with a coredomain type, so add the
# coredomain attribute here (system_ext private policy), not in vendor policy.
typeattribute opluscamera_app coredomain;

# The camera app legitimately stores data under /data/vendor (camera effects,
# tuning data, etc.). The platform neverallows block coredomain access to
# vendor_data_file, so use the designated exemption attribute for
# data-between-core-and-vendor traffic.
typeattribute opluscamera_app data_between_core_and_vendor_violators;

# The OnePlus camera loads OPLUS vendor libraries (libui-stock, libutils-stock,
# libvega_common, libHIS, etc.) and the FastRPC shell directly. These are
# vendor_file_type files, which coredomain cannot read/execute per the platform
# neverallows. This is the designated exemption attribute for platform domains
# that must execute vendor binaries (same mechanism profcollectd etc. use).
typeattribute opluscamera_app system_executes_vendor_violators;

#  Own data directory
allow opluscamera_app opluscamera_app_data_file:dir  create_dir_perms;
allow opluscamera_app opluscamera_app_data_file:file create_file_perms;
allow opluscamera_app opluscamera_app_data_file:{ lnk_file sock_file fifo_file } create_file_perms;

#  Binder infrastructure
binder_use(opluscamera_app)
binder_call(opluscamera_app, system_server)
binder_call(opluscamera_app, surfaceflinger)
binder_call(opluscamera_app, statsd)
# Camera APS talks to system_suspend (service find is in vendor te).
binder_call(opluscamera_app, system_suspend)

#  Media / storage (same as platform_app)
allow opluscamera_app mnt_media_rw_file:dir   r_dir_perms;
allow opluscamera_app sdcard_type:dir         create_dir_perms;
allow opluscamera_app sdcard_type:file        create_file_perms;
allow opluscamera_app rootfs:dir              getattr;
allow opluscamera_app proc_vmstat:file        r_file_perms;
r_dir_file(opluscamera_app, proc_net_type)

#  Properties (same as platform_app)
get_prop(opluscamera_app, audio_config_prop)
get_prop(opluscamera_app, qemu_hw_prop)

allow opluscamera_app app_api_service:service_manager find;
allow opluscamera_app audioserver_service:service_manager find;
allow opluscamera_app cameraserver_service:service_manager find;
allow opluscamera_app drmserver_service:service_manager find;
allow opluscamera_app mediadrmserver_service:service_manager find;
allow opluscamera_app mediaextractor_service:service_manager find;
allow opluscamera_app mediametrics_service:service_manager find;
allow opluscamera_app mediaserver_service:service_manager find;
allow opluscamera_app radio_service:service_manager find;
allow opluscamera_app vr_manager_service:service_manager find;
allow opluscamera_app nfc_service:service_manager find;


#  system_server UDP socket (same as platform_app)
allow opluscamera_app system_server:udp_socket {
    getattr read recvfrom write getopt setopt };

#  Suppress noisy debugfs denials
dontaudit opluscamera_app debugfs_tracing:file rw_file_perms;

# OplusShoulderPressureManagerService falls back to default_android_service
# because it has no label. Cannot allow (neverallow blocks it), so suppress.
dontaudit opluscamera_app default_android_service:service_manager find;

# cameraserver sets scheduling policy of camera binder/capture threads.
allow cameraserver opluscamera_app:process setsched;

# APSFileStorage (libAlgoProcess) keeps deferred-job bookkeeping under
# /data/system/camera_rus (jobSize/) and libcsextimpl reads the camera f/w
# config JSONs from there. Stock labels this path with a dedicated core data
# type; without it the directory falls back to system_data_file, which the
# camera app cannot write, so quick-JPEG promotion to the final MediaStore
# entry fails and the photo only shows up after the deferred job completes.
type data_system_camera_rus, file_type, data_file_type, core_data_file_type;

allow opluscamera_app data_system_camera_rus:dir {
    read write create getattr setattr rename open add_name search };
allow opluscamera_app data_system_camera_rus:file {
    read write create getattr setattr append unlink rename open };

allow cameraserver data_system_camera_rus:dir { read open search };
allow cameraserver data_system_camera_rus:file { read getattr setattr open };

allow installd data_system_camera_rus:dir { read open search };
allow installd data_system_camera_rus:file { read open };

allow system_server data_system_camera_rus:dir {
    ioctl read write create getattr setattr lock relabelfrom rename open
    watch watch_reads add_name remove_name reparent search rmdir };
allow system_server data_system_camera_rus:file {
    ioctl read write create getattr setattr lock append map unlink rename open
    watch watch_reads };
